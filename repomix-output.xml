<file path="client.py">
"""client.py — Punto de entrada ejecutable del cliente TCP de consola.

Uso:
    python client.py
    python client.py --host 127.0.0.1 --port 9000 \\
                     --cert certs/client1/client1.pem \\
                     --key certs/client1/client1.key \\
                     --ca certs/ca/ca.pem

Flujo de ejecución:
1. Configura credenciales PKI del cliente (certificado X.509 y clave privada).
2. Conecta por TCP al servidor y ejecuta el handshake mutuo (M1->M4).
3. Tras autenticarse y negociar clave simétrica AES-256-GCM, inicia los menús.
4. Desacoplado por completo de SQLAlchemy: solo interactúa con ServerGateway.
"""

from __future__ import annotations

import argparse
import os
import sys

from src.client.gateway import ConnectionFailedError, ServerGateway
from src.client.ui.console import console
from src.client.ui.main_menu import run_main_menu
from src.common.handshake import ClientSecurityConfig


def main() -> None:
    """Punto de entrada del cliente interactivo TCP.

    Parsea argumentos CLI, carga credenciales PKI del cliente y del CA,
    establece la conexión segura autenticada mediante ServerGateway y ejecuta
    el menú interactivo de la consola Rich. Maneja interrupciones y fallos de
    red informando limpiamente en pantalla.
    """
    parser = argparse.ArgumentParser(
        description="Tournament Back-Office TCP Client"
    )
    parser.add_argument("--host", default="127.0.0.1", help="Server host")
    parser.add_argument("--port", type=int, default=9000, help="Server port")
    parser.add_argument(
        "--cert",
        default=os.getenv("CLIENT_CERT_PATH", "certs/client1/client1.pem"),
        help=(
            "Path to client X.509 certificate PEM (default: "
            "certs/client1/client1.pem)"
        ),
    )
    parser.add_argument(
        "--key",
        default=os.getenv("CLIENT_KEY_PATH", "certs/client1/client1.key"),
        help=(
            "Path to client RSA private key PEM (default: "
            "certs/client1/client1.key)"
        ),
    )
    parser.add_argument(
        "--ca",
        default=os.getenv("CA_CERT_PATH", "certs/ca/ca.pem"),
        help=(
            "Path to trusted Root CA certificate PEM (default: "
            "certs/ca/ca.pem)"
        ),
    )
    parser.add_argument(
        "--server-hostname",
        default=os.getenv("SERVER_HOSTNAME", "localhost"),
        help="Expected server SAN hostname/IP (default: localhost)",
    )
    parser.add_argument(
        "--handshake-timeout",
        type=float,
        default=10.0,
        help="Maximum seconds allowed for mutual handshake (default: 10.0)",
    )
    args = parser.parse_args()

    try:
        security = ClientSecurityConfig.from_files(
            cert_path=args.cert,
            key_path=args.key,
            ca_path=args.ca,
            server_hostname=args.server_hostname,
            handshake_timeout=args.handshake_timeout,
        )
    except Exception as exc:
        console.print(
            f"[error]  Failed to load client PKI credentials: {exc}[/]"
        )
        sys.exit(2)

    try:
        with ServerGateway(
            host=args.host, port=args.port, security=security
        ) as gw:
            peer_cn = (
                gw.session.peer_common_name
                if gw.session is not None
                else "unknown"
            )
            console.print(
                f"[success]  Connected securely to {args.host}:{args.port} "
                f"(verified server CN={peer_cn!r}, AES-256-GCM)[/]"
            )
            run_main_menu(gw)
    except ConnectionError as exc:
        console.print(f"[error]  Connection to the server lost: {exc}[/]")
        sys.exit(1)
    except KeyboardInterrupt:
        console.print("\n[info]  Interrupted by user.[/]")
    except ConnectionFailedError as exc:
        console.print(f"[error]  {exc}[/]")
        console.print("[info]  Start the server with:  python server.py[/]")
        sys.exit(1)


if __name__ == "__main__":
    main()
</file>

<file path="verify.py">
"""verify.py — Comprobación de integridad y arquitectura del proyecto.

Verifica:
1. Configuración y aislamiento de entorno (APP_ENV=test con SQLite en memoria).
2. Creación del esquema de base de datos (7 tablas y columna last_update).
3. Integridad de la tabla declarativa de rutas (5 recursos, 51 acciones).
4. Aislamiento del cliente: valida que el cliente jamás importa SQLAlchemy,
   modelos de dominio ni código del servidor.

Uso:
    python verify.py
"""

import os
import subprocess
import sys

os.environ["APP_ENV"] = "test"
os.environ["DATABASE_URL_TEST"] = "sqlite:///:memory:"

print("Checking imports...")

from sqlalchemy import inspect as sa_inspect  # noqa: E402

from src.domain.config import ENVIRONMENT  # noqa: E402
from src.domain.db import Base, engine  # noqa: E402
from src.domain.models import (  # noqa: E402
    Category,
    Fighter,
    FighterCategoryRegistration,
    Match,
    MedicalRecord,
    Tatami,
    Tournament,
)
from src.domain.models.base import Base as ModelsBase  # noqa: E402
from src.domain.repositories import (  # noqa: E402,F401
    CategoryRepository,
    FighterRepository,
    MatchRepository,
    RegistrationRepository,
    TournamentRepository,
    UnitOfWork,
)
from src.server.router import Router  # noqa: E402,F401
from src.server.routes import ROUTES  # noqa: E402

print(f"  OK  Config loaded - ENVIRONMENT='{ENVIRONMENT}'")
print(f"  OK  Engine: {engine}")
print("  OK  Models, repositories, services and router imported")

Base.metadata.create_all(engine)
tables = set(sa_inspect(engine).get_table_names())
expected = {
    "fighter",
    "medical_record",
    "tournament",
    "tatami",
    "category",
    "fighter_category_registration",
    "match",
}
missing = expected - tables
assert not missing, f"Missing tables: {missing}"
print(f"  OK  Schema created - {len(tables)} tables: {sorted(tables)}")

for model in (
    Fighter,
    MedicalRecord,
    Tournament,
    Tatami,
    Category,
    FighterCategoryRegistration,
    Match,
):
    columns = [column.key for column in sa_inspect(model).columns]
    assert "last_update" in columns, f"last_update missing in {model.__name__}"
print("  OK  last_update column declared on all ORM models")

assert ModelsBase is Base, "models/base.py must re-export db.Base"
print("  OK  Base metadata is shared by db.py and models/")

routes = sum(len(actions) for actions in ROUTES.values())
print(f"  OK  Routing table: {len(ROUTES)} resources, {routes} actions")

# The client must work without any ORM / persistence code loaded.
probe = (
    "import sys; import src.client.gateway, src.client.ui.main_menu;"
    "bad = [m for m in sys.modules if m.split('.')[0] == 'sqlalchemy'"
    " or m.startswith(('src.domain', 'src.server'))];"
    "sys.exit(1 if bad else 0)"
)
result = subprocess.run([sys.executable, "-c", probe], check=False)
assert result.returncode == 0, "Client imports persistence/server code!"
print("  OK  Client does not import SQLAlchemy, domain or server code")

print("\nAll checks passed - project is correctly structured.")
