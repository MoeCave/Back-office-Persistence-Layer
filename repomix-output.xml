    else:
        info("  No tatamis configured for this tournament.")


# ── Submenu ──────────────────────────────────────────────────────────────────

_MENU_ITEMS = [
    ("List all tournaments", _list_all),
    ("Get tournament by ID (+ relationships)", _read_by_id),
