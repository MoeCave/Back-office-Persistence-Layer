            assert updated["birth_date"].startswith("2000-05-05")
            assert len(gw.fighters.list_all()) == 1

            gw.fighters.delete(fighter_id)
            assert gw.fighters.get(fighter_id) is None
            assert gw.fighters.list_all() == []

