"""client/gateway.py — Pasarela TCP cliente para los menús de la interfaz.

ServerGateway sustituye las llamadas directas a UnitOfWork en el cliente.
Encapsula el enmarcado del protocolo, el handshake mutuo X.509 y el cifrado
AES-256-GCM, exponiendo proxies tipados (fighters, tournaments, categories,
matches, registrations) que reflejan los servicios del servidor.

Garantiza que el cliente no importe SQLAlchemy ni la capa de persistencia.
"""

from __future__ import annotations

import socket
from typing import Any

from src.common.crypto import CipherIntegrityError, CryptoError, SessionCipher
from src.common.handshake import (
    AuthenticatedSession,
    ClientSecurityConfig,
    perform_client_handshake_sync,
)
from src.common.protocol import (
    DEFAULT_HOST,
    DEFAULT_PORT,
    ErrorCode,
    MalformedMessageError,
    MessageTooLargeError,
    receive_encrypted_message,
    receive_message,
    send_encrypted_message,
    send_message,
)


class ServerError(Exception):
    """Raised when the server responds with success=false.

    ``code`` holds the machine-readable ``error_code`` of the response.
    """

    def __init__(
        self, message: str, code: str = ErrorCode.BAD_REQUEST
    ) -> None:
        super().__init__(message)
        self.code = code


class ConnectionFailedError(Exception):
    """Raised when the TCP connection or mutual handshake fails."""


class ServerGateway:
    """Persistent TCP connection to the server.

    Usage:
        gw = ServerGateway()
        gw.connect()
        fighters = gw.fighters.list_all()
        gw.close()

    Or as a context manager:
        with ServerGateway() as gw:
            fighters = gw.fighters.list_all()
    """

    def __init__(
        self,
        host: str = DEFAULT_HOST,
        port: int = DEFAULT_PORT,
        security: ClientSecurityConfig | None = None,
    ) -> None:
        self._host = host
        self._port = port
        self._security = security
        self._sock: socket.socket | None = None
        self._session: AuthenticatedSession | None = None
        self._cipher: SessionCipher | None = None

        # Sub-namespaces (populated after connect)
        self.fighters: _FighterProxy
        self.tournaments: _TournamentProxy
        self.categories: _CategoryProxy
        self.matches: _MatchProxy
        self.registrations: _RegistrationProxy

    @property
    def session(self) -> AuthenticatedSession | None:
        """Return the authenticated session metadata when security is
        enabled."""
        return self._session

    # -- Lifecycle --------------------------------------------------------

    def connect(self) -> None:
        """Open a blocking TCP connection and perform optional mutual
        handshake."""
        sock: socket.socket | None = None
        try:
            sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            sock.connect((self._host, self._port))
            if self._security is not None:
                session = perform_client_handshake_sync(sock, self._security)
                self._session = session
                self._cipher = session.cipher
            else:
                self._session = None
                self._cipher = None
            self._sock = sock
        except (
            OSError,
            CryptoError,
            MalformedMessageError,
            MessageTooLargeError,
            ConnectionError,
        ) as exc:
            if sock is not None:
                try:
                    sock.close()
                except OSError:
                    pass
            self._sock = None
            self._session = None
            self._cipher = None
            raise ConnectionFailedError(
                f"Cannot connect to server at {self._host}:{self._port}. Is "
                f"the server running? ({exc})"
            ) from exc

        self.fighters = _FighterProxy(self)
        self.tournaments = _TournamentProxy(self)
        self.categories = _CategoryProxy(self)
        self.matches = _MatchProxy(self)
        self.registrations = _RegistrationProxy(self)

    def close(self) -> None:
        """Close the TCP connection."""
        if self._sock:
            try:
                self._sock.close()
            except OSError:
                pass
            self._sock = None
        self._session = None
        self._cipher = None

    def __enter__(self) -> "ServerGateway":
        self.connect()
        return self

    def __exit__(self, *_) -> None:
        self.close()

    # -- Raw request ------------------------------------------------------

    def request(
        self,
        resource: str,
        action: str,
        payload: dict[str, Any] | None = None,
    ) -> Any:
        """Send one request and return the data field on success.

        Raises:
            ServerError:          server returned success=false or integrity
            failed.
            ConnectionFailedError: socket is not open.
            ConnectionError:      connection dropped mid-request.
        """
        if self._sock is None:
            raise ConnectionFailedError("Not connected. Call connect() first.")

        envelope = {
            "resource": resource,
            "action": action,
            "payload": payload or {},
        }
        try:
            if self._cipher is not None:
                send_encrypted_message(self._sock, self._cipher, envelope)
                response = receive_encrypted_message(self._sock, self._cipher)
            else:
                send_message(self._sock, envelope)
                response = receive_message(self._sock)
        except CipherIntegrityError as exc:
            raise ServerError(
                f"Encrypted frame integrity check failed: {exc}",
                ErrorCode.INTEGRITY_ERROR,
            ) from exc

        if not response.get("success"):
            raise ServerError(
                response.get("error") or "Unknown server error.",
                response.get("error_code") or ErrorCode.BAD_REQUEST,
            )
        return response.get("data")

    def get_or_none(
        self,
        resource: str,
        action: str,
        payload: dict[str, Any] | None = None,
    ) -> Any:
        """Like :meth:`request`, but return None when nothing is found.

        Only ``NOT_FOUND`` is swallowed; any other server error is raised.
        """
        try:
            return self.request(resource, action, payload)
        except ServerError as exc:
            if exc.code == ErrorCode.NOT_FOUND:
                return None
            raise


